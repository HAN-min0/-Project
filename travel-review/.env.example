# Shared online mode: copy the Supabase Session pooler URI into Render, not GitHub.
DATABASE_URL=
# Optional separate password: URL encoding is handled by the server.
DATABASE_PASSWORD=
# Use at least 16 characters. Render Blueprint generates this automatically.
ADMIN_PASSWORD=
SUPABASE_PROJECT_REF=
# Render supplies RENDER_EXTERNAL_URL. Other hosts need PUBLIC_ORIGIN.
PUBLIC_ORIGIN=
# Optional trusted database CA certificate in PEM format (literal \n supported).
DATABASE_CA_CERT=
# Optional server-side AI; public visitors use rules, model access requires admin login.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional legacy SQLite path and server port.
# TRAVEL_DB_PATH=data/travel.sqlite
# PORT=3000
